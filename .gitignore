# ==============================================================================
# Git Ignore Configuration for AgriDSS
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables (Keep .env secret; share only .env.example)
.env

# Logs and databases
*.log
data/logs/

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary scratch and snippet files
*snippet*.txt
dump_snippet*.py
